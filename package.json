{
  "name": "healthcare-appointment",
  "version": "1.0.0",
  "description": "Healthcare Appointment & Follow-up Manager Platform",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc",
    "build": "npx prisma generate && npx prisma db push && npm run build:server && node dist/server/seed.js && npm run build:client",
    "start": "node dist/server/index.js",
    "postinstall": "prisma generate",
    "seed": "node dist/server/seed.js",
    "prisma:push": "prisma db push"
  },
  "keywords": [
    "healthcare",
    "appointment",
    "ai",
    "llm",
    "medical",
    "google-calendar",
    "nodemailer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "googleapis": "^148.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "openai": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
