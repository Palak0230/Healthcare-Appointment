# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# Database URL (SQLite default for zero-config local run)
DATABASE_URL="file:./dev.db"

# LLM Configuration (Gemini or OpenAI)
# If left blank, system gracefully defaults to structured AI fallback summary generator!
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini # 'gemini' or 'openai'

# Email Notification Service (Nodemailer / SMTP)
# If left blank, Nodemailer uses Ethereal test accounts or console logging
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Healthcare Clinic <noreply@healthcare-clinic.com>"

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
